{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/marce/Desktop/trochilus/.claude/hooks/document-before-commit.cjs\"",
            "if": "Bash(git commit:*)",
            "timeout": 10,
            "statusMessage": "Checking that the work is documented..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/marce/Desktop/trochilus/.claude/hooks/no-backslashes-in-shell-writes.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking for backslashes in shell writes..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/marce/Desktop/trochilus/.claude/hooks/time-from-date.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking that a prediction's time comes from date..."
          }
        ]
      }
    ]
  }
}
