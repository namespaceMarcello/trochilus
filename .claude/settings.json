{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/marce/Desktop/trochilus/.claude/hooks/document-before-commit.cjs\"",
            "if": "Bash(git commit:*)",
            "timeout": 10,
            "statusMessage": "Controllo che il lavoro sia documentato..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/marce/Desktop/trochilus/.claude/hooks/no-backslashes-in-shell-writes.cjs\"",
            "timeout": 10,
            "statusMessage": "Controllo barre rovesciate nelle scritture da shell..."
          }
        ]
      }
    ]
  }
}
